[configuration]

entry_symbol = "terrain_server_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

; macOS
macos.debug = "res://addons/terrain_server/bin/libterrain_server.macos.template_debug.framework"
macos.release = "res://addons/terrain_server/bin/libterrain_server.macos.template_release.framework"

; Windows
windows.debug.x86_64 = "res://addons/terrain_server/bin/libterrain_server.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/terrain_server/bin/libterrain_server.windows.template_release.x86_64.dll"

; Linux
linux.debug.x86_64 = "res://addons/terrain_server/bin/libterrain_server.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/terrain_server/bin/libterrain_server.linux.template_release.x86_64.so"

[icons]

Terrain3D = "res://addons/terrain_server/icons/Terrain3D.svg"
TerrainConfiguration = "res://addons/terrain_server/icons/TerrainConfiguration.svg"
TerrainBiomeLayer = "res://addons/terrain_server/icons/TerrainBiomeLayer.svg"
TerrainSlopeLayer = "res://addons/terrain_server/icons/TerrainSlopeLayer.svg"
